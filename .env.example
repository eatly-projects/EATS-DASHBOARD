# ============================================================================
#  Contoh .env — EATS Dashboard. Salin jadi `.env` di akar project lalu isi.
#  Hanya ADA SATU berkas .env di project ini (dibaca backend). Frontend tidak
#  butuh .env.
# ============================================================================

NODE_ENV=development
PORT=4910
# Alamat frontend yang boleh memanggil API (pisahkan dengan koma).
CLIENT_ORIGIN=http://localhost:5178

# Peran khusus aplikasi (finance_app) lewat pooler Supabase port 6543.
# Diisi otomatis oleh: cd server && npm run peran:buat -- --ya
DATABASE_URL=postgresql://finance_app.<kode-project>:<kata-sandi>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# Peran postgres, HANYA untuk migrasi (npm run migrate). Jangan diisi di Vercel.
MIGRASI_DATABASE_URL=postgresql://postgres.<kode-project>:<kata-sandi>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_SCHEMA=finance

# Acak, minimal 32 karakter:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# AI pembaca dokumen
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
