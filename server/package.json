{
  "name": "eats-dashboard-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend EATS Dashboard: Express + Postgres langsung (schema finance di database bos) + pembaca dokumen AI (Claude, cadangan Gemini).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node migrations/jalankan.js",
    "peran:buat": "node scripts/buat-peran-aplikasi.js",
    "pengguna:buat": "node scripts/buat-pengguna.js",
    "cek:db": "node scripts/cek-db.js",
    "uji:isolasi": "node scripts/uji-isolasi.js",
    "uji": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
